<?xml version="1.0"?>
<!-- Cave-exploring quadcopter drone for Gazebo Harmonic.
     - X-frame body with 4 colored rotors at the corners.
     - 3D GPU LiDAR sensor on top.
     - Gazebo Harmonic velocity-control plugin: subscribes to
       /model/cave_robot/cmd_vel (gz.msgs.Twist) and moves the drone
       kinematically without needing thrust/torque modelling.
     - Gravity disabled; drone hovers and translates per cmd_vel. -->
<robot name="cave_robot">

  <!-- ── Base body: X-frame from two crossed boxes ───────────────────── -->
  <link name="base_link">
    <visual name="frame_diag1">
      <origin xyz="0 0 0" rpy="0 0 0.7854"/>
      <geometry><box size="0.90 0.10 0.06"/></geometry>
      <material name="drone_blue"><color rgba="0.10 0.30 0.75 1.0"/></material>
    </visual>
    <visual name="frame_diag2">
      <origin xyz="0 0 0" rpy="0 0 -0.7854"/>
      <geometry><box size="0.90 0.10 0.06"/></geometry>
      <material name="drone_blue"/>
    </visual>
    <visual name="hub">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.26 0.26 0.10"/></geometry>
      <material name="hub_dark"><color rgba="0.15 0.15 0.20 1.0"/></material>
    </visual>
    <!-- LED beacon under hub for visibility -->
    <visual name="beacon">
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><sphere radius="0.06"/></geometry>
      <material name="beacon_red"><color rgba="1.0 0.10 0.10 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.50 0.50 0.18"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.031" ixy="0" ixz="0"
               iyy="0.031" iyz="0" izz="0.063"/>
    </inertial>
  </link>

  <!-- ── 4 Rotors (disc visuals at frame ends) ─────────────────────── -->
  <!-- Front-Left: green -->
  <link name="rotor_fl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.14" length="0.025"/></geometry>
      <material name="rotor_fl_c"><color rgba="0.10 0.85 0.20 0.85"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="rotor_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rotor_fl"/>
    <origin xyz="0.32 0.32 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Front-Right: red -->
  <link name="rotor_fr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.14" length="0.025"/></geometry>
      <material name="rotor_fr_c"><color rgba="0.95 0.20 0.20 0.85"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="rotor_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rotor_fr"/>
    <origin xyz="0.32 -0.32 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Back-Left: yellow -->
  <link name="rotor_bl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.14" length="0.025"/></geometry>
      <material name="rotor_bl_c"><color rgba="0.95 0.85 0.10 0.85"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="rotor_bl_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rotor_bl"/>
    <origin xyz="-0.32 0.32 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Back-Right: blue -->
  <link name="rotor_br">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.14" length="0.025"/></geometry>
      <material name="rotor_br_c"><color rgba="0.20 0.45 0.95 0.85"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="rotor_br_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rotor_br"/>
    <origin xyz="-0.32 -0.32 0.07" rpy="0 0 0"/>
  </joint>

  <!-- ── Gazebo Harmonic model-level plugins ────────────────────────── -->
  <!-- Model-scope plugins (note: NO `reference=` attribute = model-level) -->
  <gazebo>
    <!-- Velocity control: subscribes /model/cave_robot/cmd_vel and applies
         linear/angular velocities directly to the model (kinematic). -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>

    <!-- Pose publisher: streams cave_robot's current pose to /model/cave_robot/pose -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>

  <!-- ── Per-link Gazebo extensions ─────────────────────────────────── -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
    <material>Gazebo/Blue</material>

    <!-- GPU 3-D LiDAR (Gazebo Harmonic native gpu_lidar sensor) -->
    <sensor name="lidar_3d" type="gpu_lidar">
      <topic>/cave_robot/lidar</topic>
      <pose>0 0 0.18 0 0 0</pose>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle> 3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.52359878</min_angle>
            <max_angle> 0.52359878</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>8.00</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
