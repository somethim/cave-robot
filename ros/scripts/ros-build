#!/usr/bin/env bash
set -eo pipefail
cd "$(dirname "$0")/.."

if [ ! -f install/setup.sh ]; then
    echo "Deps not built yet. Run: just ros-bootstrap"
    exit 1
fi

echo "[...] Sourcing ROS 2 Jazzy..."
. /opt/ros/jazzy/setup.bash
echo "[ OK ] ROS 2 ready"

echo "[...] Building your ROS packages..."
colcon build --symlink-install --paths src/* --continue-on-error
echo "[ OK ] Build complete"

echo "[...] Rebuilding ament_cargo packages (colcon cannot build them)..."
for pkg_dir in src/*/; do
    pkg_name=$(basename "$pkg_dir")
    if grep -q '<build_type>ament_cargo</build_type>' "$pkg_dir/package.xml" 2>/dev/null; then
        echo "  -> Manually building $pkg_name..."
        (cd "$pkg_dir" && cargo build --release 2>&1 | sed 's/^/     /')
        if [ -f "$pkg_dir/target/release/$pkg_name" ]; then
            install_dir="install/$pkg_name/lib/$pkg_name/"
            mkdir -p "$install_dir"
            cp "$pkg_dir/target/release/$pkg_name" "$install_dir"
            echo "  -> Copied $pkg_name binary to $install_dir"
        fi
    fi
done
echo "[ OK ] ament_cargo packages rebuilt"

# Post-build: verify expected packages were installed
# (colcon may use merged layout install/share/ or prefix-per-package install/<pkg>/)
echo "[...] Verifying packages..."
missing=""
for pkg in cave_robot_node; do
    if [ -d "install/share/$pkg" ] || [ -d "install/$pkg/share/$pkg" ]; then
        : # found
    else
        missing="$missing $pkg"
    fi
done
if [ -n "$missing" ]; then
    echo ""
    echo "WARNING: some packages were NOT built:${missing}"
    echo ""
    echo "Common causes:"
    echo "  - colcon-cargo plugin missing (run: just ros-bootstrap to check)"
    echo "  - Rust compilation error (check output above for cargo errors)"
    echo "  - Missing ROS dependencies in package.xml"
    echo ""
    echo "Installed packages (install/share/)"
    ls install/share/ 2>/dev/null || echo "  (none — merged layout)"
    echo "Installed packages (install/*/share/)"
    ls -d install/*/share/*/ 2>/dev/null || echo "  (none — prefix layout)"
    exit 1
fi
echo "[ OK ] All packages present"
echo "  $(ls -d install/*/share/*/ 2>/dev/null || ls install/share/ 2>/dev/null | tr '\n' ' ')"
