<?xml version="1.0"?>
<!-- Cave-exploring quadcopter for Gazebo Harmonic.
     - X-frame body with 4 colored rotors at corners.
     - 3D GPU LiDAR mounted on a payload link above the hub.
     - Velocity control plugin: subscribes to /model/cave_robot/cmd_vel
       (gz.msgs.Twist) and kinematically moves the drone.
     - Pose publisher: streams to /model/cave_robot/pose.
     - Payload joint: a fixed joint that can be broken (lidar_mount)
       to drop the LiDAR at the destination. -->
<sdf version="1.9">
  <model name="cave_robot">
    <static>false</static>

    <!-- ─── Drone body ─── -->
    <link name="base_link">
      <gravity>false</gravity>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.032</ixx><iyy>0.032</iyy><izz>0.060</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Scaled to 60 % of original so the drone fits comfortably through
           1 m corridors (0.28 m wide → 0.40 m diagonal when turning). -->
      <visual name="frame_diag1">
        <pose>0 0 0 0 0 0.7854</pose>
        <geometry><box><size>0.30 0.03 0.02</size></box></geometry>
        <material>
          <ambient>0.10 0.30 0.75 1</ambient>
          <diffuse>0.10 0.30 0.75 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <visual name="frame_diag2">
        <pose>0 0 0 0 0 -0.7854</pose>
        <geometry><box><size>0.30 0.03 0.02</size></box></geometry>
        <material>
          <ambient>0.10 0.30 0.75 1</ambient>
          <diffuse>0.10 0.30 0.75 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.08 0.08 0.03</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.20 1</ambient>
          <diffuse>0.15 0.15 0.20 1</diffuse>
        </material>
      </visual>
      <visual name="beacon">
        <pose>0 0 -0.015 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material>
          <ambient>1.00 0.10 0.10 1</ambient>
          <diffuse>1.00 0.10 0.10 1</diffuse>
          <emissive>0.80 0.05 0.05 1</emissive>
        </material>
      </visual>

      <visual name="rotor_fl">
        <pose>0.09 0.09 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.009</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.85 0.20 0.85</ambient>
          <diffuse>0.10 0.85 0.20 0.85</diffuse>
        </material>
      </visual>
      <visual name="rotor_fr">
        <pose>0.09 -0.09 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.009</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.20 0.20 0.85</ambient>
          <diffuse>0.95 0.20 0.20 0.85</diffuse>
        </material>
      </visual>
      <visual name="rotor_bl">
        <pose>-0.09 0.09 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.009</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.85 0.10 0.85</ambient>
          <diffuse>0.95 0.85 0.10 0.85</diffuse>
        </material>
      </visual>
      <visual name="rotor_br">
        <pose>-0.09 -0.09 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.009</length></cylinder></geometry>
        <material>
          <ambient>0.20 0.45 0.95 0.85</ambient>
          <diffuse>0.20 0.45 0.95 0.85</diffuse>
        </material>
      </visual>

      <!-- Box covers the full rotor span: tips reach 0.126 m per axis
           (rotor at ±0.09 m + 0.036 m radius), 0.28 m wide with margin. -->
      <collision name="body_col">
        <geometry><box><size>0.28 0.28 0.08</size></box></geometry>
      </collision>
    </link>

    <!-- ─── LiDAR payload link (above the drone, droppable) ─── -->
    <link name="lidar_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="payload_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.90 0.85 0.15 1</ambient>
          <diffuse>0.90 0.85 0.15 1</diffuse>
          <emissive>0.40 0.35 0.05 1</emissive>
        </material>
      </visual>
      <collision name="payload_collision">
        <geometry><cylinder><radius>0.04</radius><length>0.12</length></cylinder></geometry>
      </collision>

      <!-- 3D GPU LiDAR -->
      <sensor name="lidar_3d" type="gpu_lidar">
        <topic>/cave_robot/lidar</topic>
        <pose>0 0 0.06 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-1.0472</min_angle>
              <max_angle>1.0472</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>20.00</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ─── Fixed joint: mount LiDAR payload above the drone ─── -->
    <joint name="lidar_mount" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose>0 0 0.15 0 0 0</pose>
    </joint>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl"/>

    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher"/>
  </model>
</sdf>
